FEATURE_CODE x5B Six Color - Green
  ATTRS C RW

FEATURE_CODE x5D Six Color - Blue
  ATTRS C RW

FEATURE_CODE x5C Six Color - Cyan
  ATTRS C RW

FEATURE_CODE x5E Six Color - Yellow
  ATTRS C RW

FEATURE_CODE x5A Six Color - Magenta
  ATTRS C RW

# DANGEROUS: write-only reset command.
FEATURE_CODE x05 Picture Adjustment Reset
  ATTRS NC WO
  VALUE x01 Execute

# ---- Input / link --------------------------------------------------------

FEATURE_CODE x60 Input Source
  ATTRS NC RW
  VALUE x11 HDMI 1
  VALUE x12 HDMI 2
  VALUE x0F DisplayPort

FEATURE_CODE xEB Auto Input Switch
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE xEC Control for HDMI
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE xED DisplayPort Version
  ATTRS NC RW
  VALUE x01 DP 1.2
  VALUE x02 DP 1.4
  VALUE x03 DP 2.1

