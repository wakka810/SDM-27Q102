FEATURE_CODE x04 Factory Reset
  ATTRS NC WO
  VALUE x01 Execute

# ---- Audio ---------------------------------------------------------------

# Present in Sony's SDM_27Q102Info table. The M10S II has no built-in
# speaker, so this feature may be inert depending on firmware/input state.
FEATURE_CODE x62 Speaker Volume
  ATTRS C RW

FEATURE_CODE x64 Headphone Volume
  ATTRS C RW

# ---- OLED panel protection / maintenance --------------------------------

FEATURE_CODE xFB Screen Saver
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE xFD Pixel Shift
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 Low
  VALUE x02 Mid
  VALUE x03 High

# MAINTENANCE / DANGEROUS: write-only operation.
FEATURE_CODE xF0 Pixel Refresh
  ATTRS NC WO
  VALUE x01 Execute

# MAINTENANCE / DANGEROUS: write-only operation. Do not use for testing.
FEATURE_CODE xF8 Panel Refresh
  ATTRS NC WO
  VALUE x01 Execute

# MAINTENANCE / DANGEROUS: initiates the monitor USB software-update path.
FEATURE_CODE xF4 USB Software Update
  ATTRS NC WO
  VALUE x01 Execute
