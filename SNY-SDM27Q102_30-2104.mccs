# Sony INZONE M10S II (SDM-27Q102) complete ddcutil UDF
#
# Target EDID observed on hardware:
#   MFG_ID       SNY
#   MODEL        SDM27Q102*30
#   PRODUCT_CODE 2104
#
# Source of feature definitions:
#   Sony INZONE Hub 1.0.19.0, INZONEHub.dll
#   PCWidget.Communication.MonitorDeviceConfig.SDM_27Q102Info
#   54/54 model-specific VCP entries recovered from managed IL.
#
# Hardware-confirmed raw values on SDM-27Q102:
#   xFE=x01 -> 540 Hz
#   xFE=x02 -> 720 Hz (HD)
#   xFF=x01 -> 24.5-inch Center
#   x51=x10 -> 2368x1332 pixel-by-pixel
#   xE5=x01 -> Adaptive-Sync/VRR On
#   x4F=x00 -> Anti-VRR Flicker Off
#
# MCCS_VERSION 2.2 below is an interpretation override for ddcutil.
# The monitor's VCP-version query is non-standard/undetected by ddcutil;
# this line is not a claim that the monitor itself advertises MCCS 2.2.
#
# WARNING: Features marked DANGEROUS / MAINTENANCE below are write-only.
# Do not issue setvcp to them casually. Panel Refresh in particular should
# not be run as a test operation.

MFG_ID       SNY
MODEL        SDM27Q102*30
PRODUCT_CODE 2104
MCCS_VERSION 2.2

# ---- Gaming assist -------------------------------------------------------

FEATURE_CODE xE5 Adaptive-Sync/VRR
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE xE4 Frame Rate Counter
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE xE2 Crosshair
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 Cursor 1
  VALUE x02 Cursor 2
  VALUE x03 Cursor 3
  VALUE x04 Cursor 4
  VALUE x05 Cursor 5
  VALUE x06 Cursor 6
  VALUE x07 Cursor 7
  VALUE x08 Cursor 8

FEATURE_CODE xE3 Timer
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 10 minutes
  VALUE x02 20 minutes
  VALUE x03 30 minutes
  VALUE x04 40 minutes
  VALUE x05 50 minutes
  VALUE x06 60 minutes

FEATURE_CODE x4D Low Latency
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 On

FEATURE_CODE x4F Anti-VRR Flicker
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 Mid
  VALUE x02 High
  VALUE x03 Extreme

FEATURE_CODE xFE Maximum Frame Rate / Overclock
  ATTRS NC RW
  VALUE x00 Overclock Off / base mode
  VALUE x01 540 Hz
  VALUE x02 720 Hz (HD)

FEATURE_CODE xFF 24.5-inch Mode
  ATTRS NC RW
  VALUE x00 Off
  VALUE x01 Center
  VALUE x02 Bottom

FEATURE_CODE x51 24.5-inch Resolution
  ATTRS NC RW
  VALUE x10 2368x1332 pixel-by-pixel
  VALUE x11 1920x1080

FEATURE_CODE xE6 Motion Blur Reduction
  ATTRS NC RW
  VALUE x10 Off
  VALUE x11 On

# DANGEROUS: write-only reset command.
FEATURE_CODE x06 Gaming Assist Reset
  ATTRS NC WO
  VALUE x01 Execute

